[Script]
http-request ^https?:\/\/api\.wsgw-rewrite\.com\/electricity\/bill\/all script-path=https://raw.githubusercontent.com/cc166/scripting-scripts/main/Loon%2F%E7%BD%91%E4%B8%8A%E5%9B%BD%E7%BD%91%2F95598.js, requires-body=true, timeout=120, tag=网上国网组件接口

[MITM]
hostname = api.wsgw-rewrite.com
