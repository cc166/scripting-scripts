#!name= 网上国网积分签到
#!desc= 抓取网上国网 App 的 Cookie 与签到请求，每天 08:30 自动积分签到；无需填写账号密码。
#!author= MaYIHEI
#!homepage= https://github.com/MaYIHEI/paperclip/tree/main/app/sgcc
#!icon= https://raw.githubusercontent.com/MaYIHEI/pin/main/app/sgcc.png
#!tag= 签到
#!loon_version= 3.2.1(372)
#!version= 20260818-1

[Script]
http-request ^https?:\/\/csc-service\.sgcc\.com\.cn:28630\/.+\/member\/ script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/main/app/sgcc/sgcc.cookie.js, requires-body=true, timeout=10, tag=网上国网凭据抓取, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/main/app/sgcc.png
cron "30 8 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/main/app/sgcc/sgcc.js, timeout=60, tag=网上国网签到, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/main/app/sgcc.png, enable=true

[MITM]
hostname = csc-service.sgcc.com.cn
