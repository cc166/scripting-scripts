#!name= 网上国网
#!desc= Primovist wsgw.sgmodule 的 Loon 适配：为 Scripting 小组件提供电费/余量接口，并保留默认关闭的每日查询任务；账号与选项沿用原 BoxJS。
#!author= 𝐎𝐍𝐙𝟑𝐕, Primovist; Loon adaptation by cc166
#!homepage= https://github.com/Primovist/Scripting
#!icon= https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/83/d8/8a/83d88a92-5a4d-7a2f-118c-80d795e7a9f6/AppIcon-0-0-1x_U007emarketing-0-5-0-0-sRGB-85-220.png/144x144.png
#!tag= 组件服务
#!loon_version= 3.2.1(372)
#!version= 20260818-1
# Source: https://raw.githubusercontent.com/Primovist/Scripting/refs/heads/main/wsgw.sgmodule
# BoxJS: https://raw.githubusercontent.com/Primovist/Scripting/refs/heads/main/boxjs.json

[Argument]
cronEnabled = switch,false,tag=启用定时查询,desc=对应原模块 INFORM；原默认值为 #，所以这里默认关闭
cronExp = input,"0 9 * * *",tag=定时表达式,desc=对应原模块 CRONEXP；默认每天 09:00
scriptTimeout = input,60,tag=脚本超时,desc=对应原模块 TIMEOUT；单位为秒

[Script]
http-request ^https?:\/\/api\.wsgw-rewrite\.com\/electricity\/bill\/all script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/95598/95598.js, requires-body=true, timeout={scriptTimeout}, tag=网上国网接口, enable=true
cron {cronExp} script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/95598/95598.js, timeout={scriptTimeout}, tag=网上国网定时查询, enable={cronEnabled}

[MITM]
hostname = api.wsgw-rewrite.com
